{
  "name": "poker-room",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Web 联机德州扑克（虚拟不可兑换筹码，单进程单端口）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "e2e": "npm run build && npm run e2e:reset && playwright test",
    "e2e:reset": "node scripts/reset-e2e-db.mjs",
    "e2e:ui": "playwright test --ui",
    "check:deploy": "node scripts/deploy-check.mjs",
    "probe:table": "node scripts/probe-table-geometry.mjs",
    "backup": "npm run build:server && node scripts/backup-drill.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@primeuix/themes": "2.0.3",
    "fastify": "^5.12.5",
    "pinia": "^4.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "fsevents": false
  }
}

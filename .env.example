# 复制为 .env 后按需修改；.env 不提交仓库。
# 生产部署建议：HOST=0.0.0.0 PORT=3000，由单进程提供网页 + API + WebSocket。
HOST=0.0.0.0
PORT=3000

# SQLite 数据文件路径（相对项目根目录或绝对路径）。目录不存在会自动创建。
DATABASE_PATH=./data/poker.sqlite

# 生产构建后的前端静态目录
CLIENT_DIR=./dist/client

# development 时行为与生产一致，仅日志更详细
NODE_ENV=production

# 同时开放的房间上限（默认 10）
# MAX_ROOMS=10

# 掉线后保留座位的宽限期（毫秒，默认 300000 = 5 分钟）
# SEAT_RELEASE_MS=300000

# 房间「没人操作」多久后自动关闭（毫秒，默认 300000 = 5 分钟）
# IDLE_ROOM_MS=300000

# 日志级别：trace | debug | info | warn | error | silent（默认 info）
# LOG_LEVEL=info
